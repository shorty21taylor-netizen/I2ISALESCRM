# Team password — fallback hardcoded if not set
TEAM_PASSWORD="I2I2026!"

# Admin emails (comma separated) — these see admin features
ADMIN_EMAILS="anthony@youremail.com"

# No database required. App runs on mock data.

# Shared secret the n8n forms use to post submissions into the CRM.
# n8n sends it as the header:  x-api-key: <this value>
# Endpoint: POST /api/forms/ingest?type=book-call | close-deal | eod-report
FORM_INGEST_KEY="change-me-to-a-long-random-string"

# Optional. When set, the closing summary on the exported sales report is written
# by Claude from the report's own figures. Without it the CRM writes the summary
# itself from the same numbers — the report is never blank either way.
ANTHROPIC_API_KEY=""
